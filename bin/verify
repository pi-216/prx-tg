#!/usr/bin/env bash
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 2
cd "$ROOT" || exit 2

PYTHON=".venv/bin/python3"
if [ ! -x "$PYTHON" ]; then
  PYTHON="python3"
fi

run() {
  local label="$1"
  shift
  printf '==> %s\n' "$label"
  if "$@"; then
    printf '  OK    %s\n' "$label"
  else
    printf '  FAIL  %s\n' "$label"
    exit 1
  fi
}

run "research governance" "$PYTHON" bin/check_research_governance
run "pytest"              "$PYTHON" -m pytest -q

printf '\nVERIFY OK\n'
